# Copy to .env.local and fill in. Both values are public and safe to ship in the
# bundle; row level security is what protects the data. Never put the
# service_role key (or a secret key) here.
#
# Find these in the Supabase dashboard under Project Settings -> API.
# The publishable key looks like: sb_publishable_xxxxxxxxxxxxxxxx

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
